# Copy to .env (gitignored) and fill in. Nothing here is read automatically —
# load it with:  set -a; . ./.env; set +a
#
# ANTHROPIC_API_KEY  research app only; the hello app and `make verify SCALE=1`
#                    work without it. In production it comes from Secret Manager.
# DEMO_PASSCODE      web tier only; empty means anyone with the URL can spend tokens.
ANTHROPIC_API_KEY=
DEMO_PASSCODE=
