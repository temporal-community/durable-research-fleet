.venv/
__pycache__/
*.pyc
.DS_Store

# Terraform state can contain sensitive values — never commit it.
# Glob every state variant: Terraform writes timestamped backups
# (terraform.tfstate.<epoch>.backup) that an exact-name rule does not catch.
terraform/.terraform/
# .terraform.lock.hcl is deliberately NOT ignored: it pins provider versions,
# and this stack REQUIRES google ~> 7.x (Worker Pools do not exist in 4.x).
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.auto.tfvars

# Large locally-built CLI binaries (see `make cli`)
bin/

# Local secrets for Phase 0 development — GEMINI_API_KEY lives here so it is
# never a shell-history entry or a Terraform value. In production the key comes
# from Secret Manager instead (terraform/secrets.tf).
.env

# Local working memory: why decisions were made, and what we already tried that
# doesn't work. Deliberately not committed — it's session narrative and judgement
# calls, not project documentation. AGENTS.md points at it for future sessions.
decisions/
